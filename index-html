  body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--fg); line-height: 1.5; }
  .page { max-width: 1200px; margin: 0 auto; padding: 32px 24px 60px; }

  .header { margin-bottom: 32px; }
  .header-top { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 6px; }
  .header h1 { font-size: 28px; font-weight: 800; letter-spacing: -0.02em; }
  .header .badge { background: var(--accent-light); color: var(--accent-dark); font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 999px; }
  .header .subtitle { color: var(--muted); font-size: 14px; }
  .header .meta { display: flex; gap: 14px; margin-top: 10px; font-size: 11px; color: var(--muted); }

  .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 28px; }
  .kpi-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px; }
  .kpi-card .kpi-label { font-size: 10px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
  .kpi-card .kpi-value { font-size: 24px; font-weight: 800; letter-spacing: -0.02em; }
  .kpi-card .kpi-sub { font-size: 11px; color: var(--muted); margin-top: 2px; }
  .kpi-card.highlight { background: linear-gradient(135deg, #059669, #047857); border: none; }
  .kpi-card.highlight .kpi-label, .kpi-card.highlight .kpi-sub { color: rgba(255,255,255,0.85); }
  .kpi-card.highlight .kpi-value { color: white; }
  .kpi-card .growth { display: inline-block; font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px; margin-left: 4px; }
  .kpi-card .growth.up { background: var(--accent-light); color: var(--accent-dark); }

  .section { margin-bottom: 32px; }
  .section-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px solid var(--border); }
  .section-header h2 { font-size: 16px; font-weight: 700; }
  .section-header .section-sub { font-size: 11px; color: var(--muted); }

  .info-box { background: var(--blue-light); border-left: 4px solid var(--blue); border-radius: 8px; padding: 12px 16px; margin-bottom: 24px; font-size: 12px; color: #1e3a8a; }
  .info-box strong { color: #1e40af; }

  .evolution-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 24px; }
  .month-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px; }
  .month-card .month-label { font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; }
  .month-card .month-value { font-size: 20px; font-weight: 800; color: var(--fg); margin-bottom: 4px; }
  .month-card .month-sub { font-size: 11px; color: var(--muted); }

  .table-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; margin-bottom: 16px; }
  table { width: 100%; border-collapse: collapse; font-size: 12px; }
  thead { background: #fafaf9; }
  th { text-align: left; padding: 10px 14px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); border-bottom: 1px solid var(--border); }
  td { padding: 10px 14px; border-bottom: 1px solid var(--border); font-variant-numeric: tabular-nums; }
  tr:last-child td { border-bottom: none; }
  tr.total-row { background: #fafaf9; font-weight: 700; }
  .iungo-text { color: var(--accent-deep); font-weight: 900; letter-spacing: 0.02em; }
  .trend-up { color: var(--accent-dark); font-weight: 700; }
  .trend-down { color: #dc2626; font-weight: 700; }

  .chart-container { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 20px; margin-bottom: 16px; }
  .chart-row { display: grid; grid-template-columns: 140px 1fr 80px; align-items: center; gap: 12px; margin-bottom: 12px; }
  .chart-row:last-child { margin-bottom: 0; }
  .chart-label { font-size: 12px; font-weight: 600; }
  .chart-bar-container { display: flex; gap: 4px; align-items: center; }
  .chart-bar { height: 24px; border-radius: 4px; display: flex; align-items: center; justify-content: flex-end; padding-right: 8px; color: white; font-size: 10px; font-weight: 700; min-width: 40px; }
  .chart-bar.jul { background: #94a3b8; }
  .chart-bar.ago { background: #64748b; }
  .chart-bar.set { background: linear-gradient(90deg, #059669, #10b981); }
  .chart-growth { font-size: 11px; font-weight: 700; color: var(--accent-dark); text-align: right; }

  .insights-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .insight-box { border-radius: 10px; padding: 16px 18px; }
  .insight-box.good { background: var(--accent-light); border-left: 4px solid var(--accent); }
  .insight-box.warn { background: #fef3c7; border-left: 4px solid var(--warn); }
  .insight-box.info { background: var(--blue-light); border-left: 4px solid var(--blue); }
  .insight-box .insight-title { font-size: 13px; font-weight: 700; margin-bottom: 8px; }
  .insight-box.good .insight-title { color: var(--accent-dark); }
  .insight-box.warn .insight-title { color: #92400e; }
  .insight-box.info .insight-title { color: #1e40af; }
  .insight-box p { font-size: 12px; line-height: 1.7; }
  .insight-box.good p { color: #064e3b; }
  .insight-box.warn p { color: #78350f; }
  .insight-box.info p { color: #1e3a8a; }
  .insight-box strong { font-weight: 700; }

  .footer { margin-top: 36px; padding-top: 16px; border-top: 1px solid var(--border); font-size: 11px; color: var(--muted); text-align: center; }

  @media (max-width: 768px) {
    .kpi-grid { grid-template-columns: repeat(2, 1fr); }
    .evolution-grid { grid-template-columns: 1fr; }
    .insights-grid { grid-template-columns: 1fr; }
    .chart-row { grid-template-columns: 100px 1fr 60px; }
  }
</style>
