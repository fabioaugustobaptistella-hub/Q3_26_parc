<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --bg: #fafaf9; --surface: #ffffff; --fg: #1a1a19; --muted: #78716c;
    --border: #e7e5e4; --accent: #059669; --accent-light: #d1fae5; --accent-dark: #047857;
